// markdownlint-cli2 configuration
//
// Rules and custom rule modules are NOT defined here. Both come from a single
// source so the CLI, the MCP tools (lint_file / fix_file), and the VS Code
// extension all see one identical rule set:
//
//   config/.markdownlint.json  → rule configuration
//   config/rules/index.cjs     → custom rule registry (auto-discovers *.cjs)
//
// This file only carries what is genuinely CLI-specific: which paths to skip.
// Deployed to other repos by: node scripts/propagate-lint-rules.mjs
{
  "customRules": ["./config/rules/index.cjs"],
  "config": {
    "extends": "./config/.markdownlint.json"
  },
  "ignores": [
    "node_modules",
    ".git",
    "dist",
    "build",
    ".planning",
    ".claude",
    "temp",
    "tmp",
    "backup",
    "backups",
    "archive",
    "_archive",
    "archives",
    "docs/slides",
    "config/markdownlint",
    "graphify-out"
  ],
  "overrides": [
    {
      "globs": ["docs/slides/**/*.md"],
      "config": {
        "MD025": false,
        "MD036": false
      }
    }
  ]
}
