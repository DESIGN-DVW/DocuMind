{
  "mcpServers": {
    "agenthub": {
      "command": "npx",
      "args": ["tsx", "/Users/Shared/htdocs/github/DVWDesign/AgentHub/src/mcp-server.ts"],
      "env": {
        "SUPABASE_URL": "${AGENTHUB_SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}"
      }
    },
    "aikido": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@aikidosec/mcp"],
      "env": {
        "AIKIDO_API_KEY": "${AIKIDO_TOKEN}"
      }
    },
    "documind": {
      "command": "node",
      "args": ["/Users/Shared/htdocs/github/DVWDesign/DocuMind/daemon/mcp-server.mjs"],
      "env": {
        "DOCUMIND_DB": "/Users/Shared/htdocs/github/DVWDesign/DocuMind/data/documind.db",
        "DOCUMIND_PROFILE": "/Users/Shared/htdocs/github/DVWDesign/DocuMind/config/profiles/dvwdesign.json"
      }
    },
    "github-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}"
      }
    },
    "langflow": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "langflow-mcp-server"],
      "env": {
        "LANGFLOW_URL": "http://localhost:7860"
      }
    },
    "n8n": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "n8n-mcp"],
      "env": {
        "N8N_API_URL": "http://localhost:5678",
        "N8N_API_KEY": ""
      }
    }
  }
}
